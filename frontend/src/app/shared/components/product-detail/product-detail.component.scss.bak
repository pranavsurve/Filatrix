.product-detail-container {
  padding: 1rem 0;
  max-width: 1200px;
  margin: 0 auto;
}

// Loading State
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 4rem 2rem;
  gap: 1rem;

  p {
    color: #666;
  }
}

// Product Content Layout
.product-content {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  margin-bottom: 2rem;

  @media (max-width: 992px) {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
}

// Product Gallery
.product-gallery {
  .main-image {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 12px;
    overflow: hidden;
    background: #f5f5f5;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;

    img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    .placeholder-image {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      color: #ccc;

      mat-icon {
        font-size: 6rem;
        width: 6rem;
        height: 6rem;
      }

      span {
        font-size: 1.25rem;
      }
    }
  }

  .thumbnail-list {
    display: flex;
    gap: 0.75rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;

    .thumbnail {
      width: 80px;
      height: 80px;
      min-width: 80px;
      padding: 0;
      border: 2px solid transparent;
      border-radius: 8px;
      overflow: hidden;
      cursor: pointer;
      background: none;
      transition: border-color 0.2s;

      &.active {
        border-color: #3f51b5;
      }

      &:hover {
        border-color: #9e9e9e;
      }

      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    }
  }

  .viewer-3d-placeholder {
    margin-top: 1.5rem;
    padding: 2rem;
    background: linear-gradient(135deg, #f5f5f5 0%, #e0e0e0 100%);
    border-radius: 12px;
    text-align: center;
    border: 2px dashed #bdbdbd;

    mat-icon {
      font-size: 3rem;
      width: 3rem;
      height: 3rem;
      color: #9e9e9e;
      margin-bottom: 0.5rem;
    }

    span {
      display: block;
      font-weight: 500;
      color: #666;
    }

    p {
      font-size: 0.875rem;
      color: #999;
      margin: 0.25rem 0 0;
    }
  }
}

// Product Info
.product-info {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;

  .product-header {
    h1 {
      font-size: 2rem;
      font-weight: 600;
      margin: 0.5rem 0 0;
      line-height: 1.3;
    }
  }

  // Rating Section
  .rating-section {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;

    .stars {
      display: flex;

      mat-icon {
        font-size: 1.25rem;
        width: 1.25rem;
        height: 1.25rem;

        &.star-filled {
          color: #ff9800;
        }

        &.star-empty {
          color: #e0e0e0;
        }
      }
    }

    .rating-value {
      font-weight: 600;
      color: #333;
    }

    .review-count {
      color: #666;
      font-size: 0.875rem;
    }
  }

  // Price Section
  .price-section {
    display: flex;
    align-items: baseline;
    gap: 1rem;

    .price {
      font-size: 2.5rem;
      font-weight: 700;
      color: #3f51b5;
    }

    .file-types {
      font-size: 0.875rem;
      color: #666;
      padding: 0.25rem 0.75rem;
      background: #f5f5f5;
      border-radius: 4px;
    }
  }

  // Stock Status
  .stock-status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #c62828;

    mat-icon {
      font-size: 1.25rem;
      width: 1.25rem;
      height: 1.25rem;
    }

    &.in-stock {
      color: #2e7d32;

      mat-icon {
        color: #2e7d32;
      }
    }
  }

  // Tags
  .tags-section {
    mat-chip {
      font-size: 0.75rem;
    }
  }

  // Seller Section
  .seller-section {
    h3 {
      font-size: 1rem;
      color: #666;
      margin-bottom: 0.75rem;
    }

    .seller-card {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 1rem;
      background: #f5f5f5;
      border-radius: 8px;

      .seller-avatar {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        overflow: hidden;
        background: white;
        display: flex;
        align-items: center;
        justify-content: center;

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
        }

        mat-icon {
          font-size: 2rem;
          width: 2rem;
          height: 2rem;
          color: #bdbdbd;
        }
      }

      .seller-info {
        display: flex;
        flex-direction: column;

        .seller-name {
          font-weight: 600;
          color: #333;
        }

        .seller-stats {
          display: flex;
          align-items: center;
          gap: 0.25rem;
          font-size: 0.875rem;
          color: #666;

          mat-icon {
            font-size: 1rem;
            width: 1rem;
            height: 1rem;
            color: #ff9800;
          }
        }
      }
    }
  }

  // Action Buttons
  .action-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;

    .btn-cart,
    .btn-wishlist {
      flex: 1;
      min-width: 140px;
      height: 48px;

      mat-icon {
        margin-right: 0.5rem;
      }
    }

    .btn-cart {
      mat-icon {
        color: white;
      }
    }

    .btn-wishlist {
      &.active {
        color: #e91e63;
        border-color: #e91e63;

        mat-icon {
          color: #e91e63;
        }
      }
    }
  }

  // Product Specs
  .product-specs {
    h3 {
      font-size: 1rem;
      color: #666;
      margin-bottom: 0.75rem;
    }

    .specs-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: 1rem;
    }

    .spec-item {
      display: flex;
      flex-direction: column;
      padding: 0.75rem;
      background: #f5f5f5;
      border-radius: 8px;

      .spec-label {
        font-size: 0.75rem;
        color: #666;
        text-transform: uppercase;
        margin-bottom: 0.25rem;
      }

      .spec-value {
        font-weight: 600;
        color: #333;
      }
    }
  }
}

// Product Tabs
.product-tabs {
  margin-top: 2rem;

  ::ng-deep .mat-mdc-tab-header {
    background: white;
    border-radius: 8px 8px 0 0;
  }

  .tab-content {
    background: white;
    padding: 2rem;
    border-radius: 0 0 8px 8px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    min-height: 300px;
  }

  // Description Tab
  .description-content {
    h2 {
      font-size: 1.5rem;
      margin-bottom: 1rem;
    }

    .description-text {
      font-size: 1rem;
      line-height: 1.8;
      color: #333;
      margin-bottom: 2rem;
    }

    .features-list,
    .usage-info {
      margin-bottom: 2rem;

      h3 {
        font-size: 1.125rem;
        margin-bottom: 1rem;
      }

      ul, ol {
        padding-left: 1.5rem;
        margin: 0;

        li {
          display: flex;
          align-items: center;
          gap: 0.5rem;
          margin-bottom: 0.5rem;

          mat-icon {
            font-size: 1rem;
            width: 1rem;
            height: 1rem;
            color: #2e7d32;
          }
        }
      }
    }

    ol li mat-icon {
      color: #3f51b5;
    }
  }

  // Reviews Tab
  .reviews-section {
    .write-review {
      margin-bottom: 2rem;
      padding-bottom: 2rem;
      border-bottom: 1px solid #e0e0e0;

      h3 {
        font-size: 1.125rem;
        margin-bottom: 1rem;
      }

      .review-form {
        max-width: 600px;

        .rating-input {
          margin-bottom: 1rem;

          label {
            display: block;
            font-size: 0.875rem;
            color: #666;
            margin-bottom: 0.5rem;
          }

          .stars-input {
            display: flex;

            button {
              padding: 0;

              mat-icon {
                font-size: 2rem;
                width: 2rem;
                height: 2rem;
                color: #ff9800;
              }
            }
          }
        }

        .full-width {
          width: 100%;
          margin-bottom: 1rem;
        }
      }
    }

    .reviews-summary {
      margin-bottom: 1.5rem;

      .summary-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;

        h3 {
          font-size: 1.125rem;
          margin: 0;
        }

        .summary-stats {
          display: flex;
          align-items: center;
          gap: 0.75rem;

          .avg-rating {
            font-size: 2rem;
            font-weight: 700;
            color: #3f51b5;
          }

          .stars {
            display: flex;

            mat-icon {
              font-size: 1.25rem;
              width: 1.25rem;
              height: 1.25rem;

              &.star-filled { color: #ff9800; }
              &.star-empty { color: #e0e0e0; }
            }
          }

          .total-reviews {
            color: #666;
            font-size: 0.875rem;
          }
        }
      }
    }

    .reviews-list {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .review-card {
      padding: 1.5rem;

      mat-card-header {
        margin-bottom: 0.5rem;

        .reviewer-avatar {
          width: 40px;
          height: 40px;
          border-radius: 50%;
          overflow: hidden;
          background: #f5f5f5;
          display: flex;
          align-items: center;
          justify-content: center;
          margin-right: 0.75rem;

          img {
            width: 100%;
            height: 100%;
            object-fit: cover;
          }

          mat-icon {
            color: #bdbdbd;
          }
        }

        mat-card-title {
          font-size: 1rem;
          margin-bottom: 0.25rem;
        }

        mat-card-subtitle {
          display: flex;
          align-items: center;
          gap: 0.75rem;
          flex-wrap: wrap;

          .review-rating {
            display: flex;

            mat-icon {
              font-size: 1rem;
              width: 1rem;
              height: 1rem;

              &.star-filled { color: #ff9800; }
              &.star-empty { color: #e0e0e0; }
            }
          }

          .review-date {
            color: #666;
            font-size: 0.875rem;
          }

          .verified-chip {
            height: 24px;
            font-size: 0.75rem;
            background: #e8f5e9;
            color: #2e7d32;

            mat-icon {
              font-size: 0.875rem;
              width: 0.875rem;
              height: 0.875rem;
              margin-right: 0.25rem;
            }
          }
        }
      }

      mat-card-content p {
        margin: 0;
        color: #333;
        line-height: 1.6;
      }
    }

    .no-reviews {
      text-align: center;
      padding: 3rem 2rem;

      mat-icon {
        font-size: 4rem;
        width: 4rem;
        height: 4rem;
        color: #ccc;
        margin-bottom: 1rem;
      }

      h3 {
        margin-bottom: 0.5rem;
      }

      p {
        color: #666;
      }
    }
  }
}

// Responsive
@media (max-width: 768px) {
  .product-content {
    gap: 1.5rem;
  }

  .product-info {
    .product-header h1 {
      font-size: 1.5rem;
    }

    .price-section .price {
      font-size: 2rem;
    }

    .action-buttons {
      flex-direction: column;

      .btn-cart,
      .btn-wishlist {
        width: 100%;
      }
    }
  }

  .product-tabs .tab-content {
    padding: 1.5rem;
  }
}